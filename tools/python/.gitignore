# Python
server/.venv
__pycache__/
*.pyc
server/.env
server/storage/
server/staticfiles/

# Node
client/node_modules
client/dist/

# OS / editors
.DS_Store
.idea/
.vscode/
# ZCode mirrors .gitignore into this and appends its own defaults, so it is
# generated, per-person, and belongs with the other editor state above; listed
# here so that a `git add -A` does not commit it.
.zcodeignore

# reference copy of the Laravel app (kept locally for porting reference,
# not part of this repo)
openqda-main/

# local working materials (flip these if you want them tracked)
# **Anchored.** Unanchored `refi/` matches a directory of that name at *any*
# depth, so when `apps/coding/refi.py` became `apps/coding/refi/` the whole
# package was silently untracked: the commit deleted the module and added
# nothing, and main was broken until CI said so. This is the test corpus at
# the repository root and nothing else.
/refi/

# transform services (local dev)
services/**/.venv/
services/**/.env
services/**/*.log
# the converter's log, rotated by date (service.log.2026-07-09)
service.log*

# reference screenshots — never tracked
screenshots/

# backup archives contain the database and the .env secrets
backups/
# pid and log files written by docs/installation/install.sh
.run/

# state and secrets of docs/installation/deploy.sh (server topology, admin
# password, SMTP credentials). Anything in here is a secret.
.openqda-deploy/

# docker-compose port overrides for machines running two checkouts side by
# side (the committed defaults are the documented ports; see the comment in
# docker-compose.yml). Local-only, never tracked.
/.env

# playwright: saved session and failure artefacts
client/e2e/.auth.json
client/test-results/
client/playwright-report/

# Generated by `vitest --coverage`. A committed snapshot is never regenerated
# and soon reports a fraction of the actual tests, which is worse than having
# none — and it is megabytes of nobody's source.
client/coverage/

# Generated by `scripts/i18n_translate.py export` — two thousand rows of the
# same strings that are already in the catalogs, and stale the moment a
# message changes. Regenerate it, do not commit it.
/i18n-translation.csv

# PeerTube's secrets and its video store. `.env` holds the database password
# and PEERTUBE_SECRET; `docker-volume/` is the instance — its database, its
# config and every uploaded video. Neither was ignored, and neither had been
# created here yet, which is the only reason nothing was committed.
docs/peertube/.env
docs/peertube/docker-volume/

# Obsidian workspace state, if someone opens docs/ as a vault
.obsidian/

# The CAQDAS comparison is an internal working document
docs/caqdas-comparison.md

# an exported private key (gpg --export-secret-keys), e.g. the backup key's
# offline copy made in the checkout: passphrase-protected, and still never a
# thing to commit
*.secret.asc

# load testing (docs/installation/load-testing.md)
.venv-locust/
/results/
